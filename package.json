{
  "name": "restaurantos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RestaurantOS API — multi-tenant restaurant & coffee operating system (Phase 1: foundation, billing)",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:demo": "node prisma/demo.js",
    "admin:create": "node scripts/create-platform-admin.js",
    "db:setup": "prisma db push && node prisma/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
