PORT=4000
NODE_ENV=development
# SQLite for local development. For production switch the provider in prisma/schema.prisma
# to "mysql" and use e.g. mysql://user:pass@host:3306/restaurantos
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Where the React app is served (CORS + Flutterwave redirect target)
CLIENT_URL=http://localhost:5173
# Public base URL of this API (used to build uploaded-file URLs)
API_PUBLIC_URL=http://localhost:4000
TRIAL_DAYS=7
# Requests per minute per IP. Keep this high: guests and staff in one restaurant share a Wi-Fi address.
RATE_LIMIT_PER_MIN=1500
# Custom domains: other hosts that are the platform itself (comma-separated), where businesses point their CNAME, and the scheme for their links.
# PLATFORM_HOSTS=app.example.com
# CNAME_TARGET=domains.example.com
# CUSTOM_DOMAIN_SCHEME=https
# The first platform administrator, created by `npm run db:setup` (sign in at /admin).
# These are DEVELOPMENT placeholders. The server and seed refuse the placeholder password in production.
ADMIN_EMAIL=admin@restaurantos.local
ADMIN_PASSWORD=ChangeMe-Dev-Only-123
ADMIN_NAME=Platform Admin
# Flutterwave (https://dashboard.flutterwave.com -> Settings -> API keys)
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com/v3
